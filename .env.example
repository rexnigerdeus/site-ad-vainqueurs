# --- Sanity CMS ---
# À remplir après création du projet sur https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
# Token read-only (Settings → API → Tokens → "next-readonly" avec droits Read)
SANITY_API_READ_TOKEN=sk_your_readonly_token_here